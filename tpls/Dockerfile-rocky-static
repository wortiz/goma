FROM rockylinux:8.9

RUN dnf update -y
RUN dnf install -y git patch gcc-toolset-14 m4 make bzip2 tar zlib-devel openssl-devel pkgconfig python3-devel findutils
RUN dnf install -y epel-release && dnf install -y ccache

# ccache lives in a build cache mount (podman/buildah), reused across image builds
ARG CCACHE_MAXSIZE=20G
# Number of parallel build jobs
ARG JOBS=2

COPY . /opt/goma

RUN --mount=type=cache,target=/ccache,id=goma-tpls-ccache \
    . /opt/rh/gcc-toolset-14/enable && \
    CCACHE_MAXSIZE=${CCACHE_MAXSIZE} PYTHONUNBUFFERED=1 /opt/goma/install-tpls.py --ccache-dir=/ccache --cc=gcc --cxx=g++ --fc=gfortran --build-static --download-dir=/tmp/downloads -j ${JOBS} --extract-dir=/tmp/extract /opt/goma-libs

RUN rm -r /opt/goma
RUN rm -r /tmp/downloads
RUN rm -r /tmp/extract
RUN rm -r /opt/goma-libs/logs

RUN { \
      echo '#!/usr/bin/env bash' \
      && echo ". /opt/rh/gcc-toolset-14/enable" \
      && echo ". /opt/goma-libs/config.sh" \
      && echo 'exec "$@"'; \
    } > /entrypoint.sh \
&& chmod a+x /entrypoint.sh

RUN echo ". /opt/rh/gcc-toolset-14/enable" > /etc/profile.d/goma-libs.sh
RUN cat /opt/goma-libs/config.sh >> /etc/profile.d/goma-libs.sh

ENV OMPI_MCA_btl "^vader"
ENV OMPI_MCA_btl_base_warn_component_unuse "0"
ENV OMPI_ALLOW_RUN_AS_ROOT 1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM 1
WORKDIR /opt/workdir

ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "/bin/bash" ]


